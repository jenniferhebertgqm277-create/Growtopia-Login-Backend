# JoTavern: DATABASE_URL lama diganti jadi 5 variabel ini karena tiap tenant
# punya database sendiri (gurotopia_<nama>), host/user/pass yang sama dipakai bareng.
# Lihat SETUP-DB.md buat skema tabel `tenants` dan contoh setup lengkapnya.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=jotavern
DB_PASS=
CONTROL_DB_NAME=jotavern_control

# JoTavern v0.2.3: IP publik VPS gateway TERKINI (VPS sewa harian, sering ganti).
# Dipakai halaman /host buat nunjukin IP yang harus di-set di PowerTunnel.
GATEWAY_IP=
